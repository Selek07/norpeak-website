# dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# environment
.env
.env.*
backend/.env
frontend/.env
# Templates hold no secrets and document required variables.
!.env.example
!backend/.env.example
# EXPO_PUBLIC_* values are baked into the public client bundle — this file
# holds no secrets and must be committed so fresh clones build correctly.
!frontend/.env.production

# Expo / build output
frontend/.expo/
frontend/.expo-shared/
frontend/dist/
coverage/
.cache/
temp_inspect_*/

# logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
