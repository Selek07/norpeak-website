# Copy to .env and fill in real values. See src/index.js for usage.
PORT=5000

# Required — the server exits at startup without these two.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional — verified sender for Resend (defaults to onboarding@resend.dev).
CONTACT_FROM_EMAIL=

# Optional — without it the API runs email-only, skipping message storage.
MONGO_URI=

# Comma-separated list of allowed browser origins in production.
CLIENT_URL=https://kolednik.com

# Express `trust proxy` hop count (default 1). The contact rate limiter keys on
# Cloudflare's CF-Connecting-IP, so this only affects req.ip in logs.
TRUST_PROXY=1
